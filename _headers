# Netlify / Cloudflare Pages 用のヘッダ設定。
# 個人情報を扱うフォームがあるため、最低限の防御を入れておく。
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'

# 画像とCSS/JSは内容が変わったらファイル名を変える運用にすれば、長期キャッシュにできる
/assets/*
  Cache-Control: public, max-age=604800
